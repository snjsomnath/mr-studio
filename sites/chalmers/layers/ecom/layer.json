{
  "api": 1,
  "id": "ecom",
  "name": "Energy community",
  "description": "A summer day of the campus energy community: who makes power, who uses it and what the grid gives",
  "icon": "bolt",
  "category": "analysis",
  "requires": {
    "kernels": [],
    "data": ["ecom_buildings", "ecom_nodes", "ecom_flows"],
    "services": ["ecom"]
  },
  "controls": [
    { "id": "hour", "type": "range", "label": "Hour of the day", "min": 0, "max": 23, "step": 1, "default": 12, "unit": "h" },
    { "id": "play", "type": "toggle", "label": "Play the day", "default": true },
    { "id": "speed", "type": "range", "label": "Seconds per hour", "min": 1, "max": 8, "step": 0.5, "default": 3, "tier": "more" }
  ],
  "entities": [
    {
      "id": "buildings",
      "dataset": "ecom_buildings",
      "key": "id",
      "label": "name",
      "group": "owner",
      "name": "Building",
      "debounce_ms": 900,
      "controls": [
        { "id": "in", "type": "toggle", "label": "In the community", "default": true, "phone": true },
        { "id": "pv", "type": "range", "label": "Solar on the roof", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 }
      ]
    }
  ],
  "legend": [
    { "id": "solar", "label": "Solar", "color": "#ffc845", "shape": "line" },
    { "id": "grid", "label": "From the grid", "color": "#ff6b5c", "shape": "line" },
    { "id": "battery", "label": "Battery", "color": "#3ddc97", "shape": "line" },
    { "id": "covered", "label": "Covered by the community", "color": "#3ddc97", "shape": "fill" }
  ],
  "panels": [
    { "id": "self", "widget": "gauge", "size": "tile", "title": "Self-sufficiency", "props": { "value": { "bind": "shared.self_sufficiency" }, "max": 1, "format": "percent", "target": 0.5 } },
    { "id": "day", "widget": "series", "size": "wide", "title": "The day", "props": { "series": [{ "label": "Use", "values": { "bind": "shared.day_use" }, "slot": 4 }, { "label": "Solar", "values": { "bind": "shared.day_solar" }, "slot": 1 }], "unit": "kW", "start": "00", "end": "24", "now": { "bind": "shared.day_now" } } },
    { "id": "where", "widget": "balance", "size": "wide", "title": "Where the power comes from", "props": { "sources": { "bind": "shared.sources" }, "uses": { "bind": "shared.uses" }, "unit": "kWh" } },
    { "id": "alone", "widget": "compare", "size": "wide", "title": "From the grid", "props": { "scenarios": { "bind": "shared.scenarios" }, "unit": "kWh", "better": "lower" } },
    { "id": "top", "widget": "list", "size": "tall", "title": "Most from the grid", "props": { "items": { "bind": "shared.importers" }, "unit": "kWh" } },
    { "id": "clock", "widget": "day-clock", "size": "chip", "ribbon": true, "title": "Time", "props": { "hour": { "bind": "shared.hour" } } }
  ],
  "stage": {
    "controls": false,
    "panels": [
      { "id": "map", "widget": "map", "size": "block", "title": "Pick a building", "at": { "col": 1, "row": 1 },
        "props": { "data": [{ "name": "ecom_flows", "slot": 1 }], "entities": "buildings", "hint": "Tap a building to change it" } },
      { "id": "clock", "widget": "day-clock", "size": "tile", "title": "Time of day", "at": { "col": 7, "row": 1 },
        "props": { "hour": { "bind": "shared.hour" }, "playing": { "bind": "params.play" } } },
      { "id": "self", "widget": "gauge", "size": "tile", "title": "Self-sufficiency", "at": { "col": 10, "row": 1 },
        "props": { "value": { "bind": "shared.self_sufficiency" }, "max": 1, "format": "percent", "target": 0.5, "slot": 3 } },
      { "id": "hour", "widget": "control", "size": "wide", "title": "Hour", "at": { "col": 7, "row": 3 }, "props": { "control": "hour" } },
      { "id": "where", "widget": "balance", "size": "wide", "title": "Where the power comes from", "at": { "col": 1, "row": 5 },
        "props": { "sources": { "bind": "shared.sources" }, "uses": { "bind": "shared.uses" }, "unit": "kWh" } },
      { "id": "alone", "widget": "compare", "size": "wide", "title": "From the grid over the day", "at": { "col": 7, "row": 5 },
        "props": { "scenarios": { "bind": "shared.scenarios" }, "unit": "kWh", "better": "lower" } }
    ]
  }
}
