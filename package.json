{
  "name": "mr-studio",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.58.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @mrstudio/runtime build",
    "typecheck": "pnpm -r typecheck",
    "test": "cargo test && pnpm -r typecheck && pnpm -r test",
    "test:e2e": "pnpm build && cargo build -p mrs-cli && pnpm e2e",
    "e2e": "playwright test -c scripts/e2e/playwright.config.cjs",
    "e2e:shots": "playwright test -c scripts/e2e/playwright.config.cjs",
    "app": "pnpm build && cargo run -p mr-studio-app",
    "app:build": "pnpm build && pnpm --filter @mrstudio/studio exec tauri build",
    "mcp": "pnpm --filter @mrstudio/mcp build",
    "test:release": "node --test scripts/release.test.mjs",
    "lint": "eslint",
    "smoke": "node scripts/smoke.cjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "eslint": "^9.39.5",
    "globals": "14.0.0",
    "jsqr": "^1.4.0",
    "playwright": "1.65.1",
    "typescript-eslint": "^8.74.0"
  }
}
