{
  "api": 1,
  "id": "isovist",
  "name": "Isovist",
  "description": "What a person standing here can see, how green that view is, and how it sounds",
  "icon": "eye",
  "attract": { "effect": "sightlines" },
  "requires": { "kernels": [], "data": ["buildings"] },
  "controls": [
    {
      "id": "fov", "type": "select", "label": "Field of view", "default": "120", "phone": true,
      "options": [
        { "value": "120", "label": "Human, 120°" },
        { "value": "360", "label": "All round" }
      ]
    },
    { "id": "sound", "type": "toggle", "label": "Soundscape", "default": true },
    { "id": "radius", "type": "range", "label": "How far the eye reaches", "min": 50, "max": 400, "step": 10, "unit": "m", "default": 200, "phone": true, "tier": "more" },
    { "id": "trees", "type": "toggle", "label": "Trees block the view", "default": true, "tier": "more" },
    { "id": "follow", "type": "toggle", "label": "The viewer walks after the pointer", "default": true, "tier": "more" },
    { "id": "streetview", "type": "toggle", "label": "Street View on the controller", "default": true, "tier": "more" },
    { "id": "source", "type": "text", "label": "Street View from", "default": "streetview", "sources": ["streetview"], "tier": "more" },
    { "id": "volume", "type": "range", "label": "Soundscape volume", "min": 0, "max": 1, "step": 0.05, "default": 0.8, "visibleWhen": { "sound": true }, "tier": "more" },
    { "id": "nature", "type": "text", "label": "Nature sound (a file in data/sounds, or empty for the built-in birdsong)", "default": "", "visibleWhen": { "sound": true }, "tier": "more" },
    { "id": "city", "type": "text", "label": "City sound (a file in data/sounds, or empty for the built-in traffic)", "default": "", "visibleWhen": { "sound": true }, "tier": "more" }
  ],
  "panels": [
    { "id": "green", "widget": "stat", "size": "tile", "title": "Green view",
      "props": { "value": { "bind": "shared.gvfPercent" }, "unit": "%", "decimals": 0, "caption": { "bind": "shared.gvfWord" } } },
    { "id": "view", "widget": "custom", "size": "wide", "title": "What the viewer sees", "props": { "reads": 4 } }
  ],
  "tools": [
    { "id": "stand", "type": "point", "label": "Where you stand" },
    { "id": "look", "type": "point", "label": "Where you look" }
  ]
}
