{
  "api": 1,
  "id": "sunlight",
  "name": "Sunlight",
  "description": "Shadows at any moment, or hours of direct sun over a day",
  "icon": "sun",
  "requires": { "kernels": ["sunlight"] },
  "controls": [
    {
      "id": "mode", "type": "select", "label": "Show", "default": "instant",
      "options": [
        { "value": "instant", "label": "Shadows" },
        { "value": "day", "label": "Sun hours" }
      ]
    },
    { "id": "date", "type": "date", "label": "Date", "default": "2026-06-21", "phone": true },
    { "id": "hour", "type": "range", "label": "Time of day", "min": 0, "max": 24, "step": 0.05, "unit": "h", "default": 12, "phone": true, "visibleWhen": { "mode": "instant" } },
    { "id": "play", "type": "toggle", "label": "Animate the day", "default": false, "visibleWhen": { "mode": "instant" } },
    { "id": "threshold", "type": "range", "label": "Flag areas with less sun than", "min": 0, "max": 12, "step": 0.5, "unit": "h", "default": 0, "visibleWhen": { "mode": "day" } },
    { "id": "path", "type": "toggle", "label": "Sun path on the table", "default": true },
    { "id": "relight", "type": "toggle", "label": "Light the 3D model", "default": false, "visibleWhen": { "mode": "instant" } },
    { "id": "trees", "type": "toggle", "label": "Trees cast shade", "default": true },
    { "id": "treeColor", "type": "toggle", "label": "Tree shade in its own colour", "default": true, "visibleWhen": { "trees": true } },
    { "id": "opacity", "type": "range", "label": "Opacity", "min": 0.1, "max": 1, "step": 0.05, "default": 1 }
  ],
  "tools": []
}
