{
  "api": 1,
  "id": "sunlight",
  "name": "Sunlight",
  "description": "Shadows at any moment, or hours of direct sun over a day",
  "about": {"purpose": "Shows shadows at any moment, the golden hour of a morning or evening, or sun hours over a day: the clearest way to discuss overshadowing and the light of a place.", "questions": ["Does a courtyard or school yard get enough sun under Boverket's guidance or BRE?", "How does a proposal change sun and shade on squares and courtyards?", "Which places get sun in the morning, at lunch, in winter?", "Where does the evening sun still reach, and where is the warm light at golden hour?"], "pairs_with": ["plan", "swipe", "coolpaths", "lens"], "limits": ["Shadows fall on the ground; sun on facades is planned", "Uses the site's buildings and trees for shadows"]},
  "icon": "sun",
  "attract": { "effect": "sun" },
  "requires": { "kernels": ["sunlight"] },
  "controls": [
    {
      "id": "mode", "type": "select", "label": "Show", "help": "Shadows at one moment, the hours of direct sun over a day, or the three seasons side by side.", "default": "instant", "tier": "primary",
      "options": [
        { "value": "instant", "label": "Shadows" },
        { "value": "golden", "label": "Golden hour" },
        { "value": "day", "label": "Sun hours" },
        { "value": "seasons", "label": "Seasons" },
        { "value": "rule", "label": "Daylight rule" }
      ]
    },
    {
      "id": "rule", "type": "select", "label": "Rule", "help": "Which daylight rule open ground is judged by. Each sets its own day, hours and share, which can then be changed.", "default": "se", "visibleWhen": { "mode": "rule" }, "tier": "primary",
      "options": [
        { "value": "se", "label": "Sweden (Boverket)" },
        { "value": "bre", "label": "UK (BRE)" }
      ]
    },
    { "id": "ruleHours", "type": "range", "label": "Sun a place needs", "help": "Hours of direct sun a place needs to pass. Boverket's guidance asks 5 h between 9 and 17 at the equinox; BRE asks 2 h on 21 March.", "min": 0.5, "max": 12, "step": 0.5, "unit": "h", "default": 5, "visibleWhen": { "mode": "rule" } },
    { "id": "ruleShare", "type": "range", "label": "Share of open ground that must pass", "help": "How much of the ground outside buildings needs that much sun for the area to pass.", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 50, "visibleWhen": { "mode": "rule" } },
    { "id": "golden", "type": "select", "label": "Golden hour", "default": "evening", "visibleWhen": { "mode": "golden" }, "tier": "primary",
      "options": [
        { "value": "evening", "label": "Evening" },
        { "value": "morning", "label": "Morning" }
      ] },
    { "id": "date", "type": "date", "clock": "date", "label": "Day", "help": "The day the sun is worked out for. Midsummer, the equinox and midwinter are one tap.", "default": "2026-06-21", "phone": true, "tier": "primary", "visibleWhen": { "mode": ["instant", "golden", "day", "seasons"] },
      "presets": [
        { "value": "06-21", "label": "Midsummer" },
        { "value": "03-20", "label": "Equinox" },
        { "value": "12-21", "label": "Midwinter" },
        { "value": "today", "label": "Today" }
      ] },
    { "id": "hour", "type": "range", "clock": "hour", "label": "Time of day", "help": "The moment the shadows are drawn for, in the table's own time zone.", "min": 0, "max": 24, "step": 0.05, "unit": "h", "default": 12, "phone": true, "visibleWhen": { "mode": ["instant", "golden"] }, "tier": "more" },
    { "id": "trails", "type": "toggle", "label": "Shadow trails over the day", "help": "Every shadow of the day at once, faint, so you see where shade sweeps across.", "default": false, "visibleWhen": { "mode": "instant" } },
    { "id": "play", "type": "toggle", "clock": "play", "label": "Animate the day", "help": "Runs through the day on its own, sunrise to sunset.", "default": false, "visibleWhen": { "mode": ["instant", "golden"] }, "tier": "more" },
    {
      "id": "window", "type": "select", "label": "Sun during", "help": "Which part of the day the sun hours count.", "default": "day", "visibleWhen": { "mode": ["day", "seasons"] },
      "options": [
        { "value": "day", "label": "All day" },
        { "value": "morning", "label": "Morning" },
        { "value": "lunch", "label": "Lunch" },
        { "value": "afternoon", "label": "Afternoon" },
        { "value": "evening", "label": "Evening" }
      ]
    },
    {
      "id": "season", "type": "select", "label": "Season on the table", "help": "Which season the table shows while the controller compares all three.", "default": "cycle", "visibleWhen": { "mode": "seasons" },
      "options": [
        { "value": "cycle", "label": "Each in turn" },
        { "value": "mar", "label": "Equinox" },
        { "value": "jun", "label": "Midsummer" },
        { "value": "dec", "label": "Midwinter" }
      ]
    },
    { "id": "threshold", "type": "range", "label": "Flag areas with less sun than", "help": "Places with fewer hours of sun than this are marked, as planning rules ask.", "min": 0, "max": 12, "step": 0.5, "unit": "h", "default": 0, "visibleWhen": { "mode": ["day", "seasons"] } },
    { "id": "path", "type": "toggle", "label": "Sun path on the table", "help": "The sun's path across the sky, drawn around the table.", "default": true, "tier": "more" },
    { "id": "relight", "type": "toggle", "label": "Light the 3D model", "help": "Lights the walls and roofs of the 3D model from the sun's direction.", "default": false, "visibleWhen": { "mode": ["instant", "golden"] }, "tier": "more" },
    { "id": "trees", "type": "toggle", "label": "Trees cast shade", "help": "Trees in the table's data cast shade as well as buildings.", "default": true, "tier": "more" },
    { "id": "treeColor", "type": "toggle", "label": "Tree shade in its own colour", "default": true, "visibleWhen": { "trees": true }, "tier": "more" },
    { "id": "clearSpot", "type": "action", "label": "Clear the spot", "tier": "more" },
    { "id": "opacity", "type": "range", "label": "Opacity", "help": "How strongly the layer draws over the map.", "min": 0.1, "max": 1, "step": 0.05, "default": 1, "tier": "more" }
  ],
  "tools": [
    { "id": "spot", "type": "point", "label": "How much sun here?", "help": "Tap a place to see how many hours of sun it gets." }
  ],
  "panels": [
    { "id": "daylight", "widget": "stat", "size": "tile", "title": "Daylight on this date", "visibleWhen": { "mode": "day", "window": "day" },
      "props": { "value": { "bind": "shared.daylightHours" }, "unit": "h", "decimals": 1, "caption": { "bind": "shared.dayStatus" } } },
    { "id": "window", "widget": "stat", "size": "tile", "title": "Sun hours counted", "visibleWhen": { "mode": "day", "window": ["morning", "lunch", "afternoon", "evening"] },
      "props": { "value": { "bind": "shared.daylightHours" }, "unit": "h", "decimals": 1, "caption": { "bind": "shared.dayStatus" } } },
    { "id": "rule", "widget": "stat", "size": "tile", "title": "Open ground with enough sun", "visibleWhen": { "mode": "rule" },
      "props": { "value": { "bind": "shared.rulePass" }, "unit": "%", "decimals": 0, "caption": { "bind": "shared.ruleVerdict" } } },
    { "id": "trees", "widget": "ramp", "size": "tile", "title": "Shade from trees", "visibleWhen": { "trees": true, "treeColor": true, "mode": ["instant", "day"] },
      "props": { "colormap": { "bind": "shared.treeRamp" }, "low": { "bind": "shared.treeLow" }, "high": { "bind": "shared.treeHigh" } } },
    { "id": "key", "widget": "ramp", "size": "band", "title": "On the table",
      "props": { "colormap": { "bind": "shared.ramp" }, "low": { "bind": "shared.rampLow" }, "high": { "bind": "shared.rampHigh" } } },
    { "id": "ribbon-time", "widget": "stat", "size": "tile", "title": "Time", "ribbon": true, "visibleWhen": { "mode": ["instant", "golden"] },
      "props": { "value": { "bind": "params.hour" }, "format": "hour" } },
    { "id": "ribbon-sun", "widget": "stat", "size": "tile", "title": "Sun height", "ribbon": true, "visibleWhen": { "mode": ["instant", "golden"] },
      "props": { "value": { "bind": "shared.altitude" }, "unit": "°", "decimals": 0 } },
    { "id": "ribbon-daylight", "widget": "stat", "size": "tile", "title": "Daylight", "ribbon": true, "visibleWhen": { "mode": "day", "window": "day" },
      "props": { "value": { "bind": "shared.daylightHours" }, "unit": "h", "decimals": 1 } },
    { "id": "ribbon-rule", "widget": "stat", "size": "tile", "title": "Enough sun", "ribbon": true, "visibleWhen": { "mode": "rule" },
      "props": { "value": { "bind": "shared.rulePass" }, "unit": "%", "decimals": 0 } },
    { "id": "ribbon-key", "widget": "ramp", "size": "tile", "title": "On the table", "ribbon": true,
      "props": { "colormap": { "bind": "shared.ramp" }, "low": { "bind": "shared.rampLow" }, "high": { "bind": "shared.rampHigh" } } }
  ]
}
