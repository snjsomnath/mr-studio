  "controls": [
    { "id": "view", "type": "toggle", "label": "Show what the walker sees", "default": true },
    { "id": "loop", "type": "toggle", "label": "Play again from the start", "default": true, "tier": "more" },
    { "id": "video", "type": "text", "label": "Video", "default": "", "none": "The table's first video", "media": ["video"], "tier": "more" },
    { "id": "path", "type": "text", "label": "Path", "default": "", "none": "The table's first walk or route", "media": ["map"], "tier": "more" },
    { "id": "opacity", "type": "range", "label": "Opacity", "min": 0.1, "max": 1, "step": 0.05, "default": 1, "tier": "more" },
    { "id": "playing", "type": "toggle", "label": "Playing", "default": false, "tier": "state" },
    { "id": "at", "type": "range", "label": "Where the video is", "min": 0, "max": 36000, "step": 0.01, "unit": "s", "default": 0, "tier": "state" },
    { "id": "since", "type": "range", "label": "When it was there", "min": 0, "max": 10000000000000, "step": 1, "default": 0, "tier": "state" }
  ],
  "tools": []
