{
  "api": 1,
  "id": "wind",
  "name": "Wind",
  "description": "How the wind moves between buildings and through trees",
  "icon": "wind",
  "requires": { "kernels": ["wind"] },
  "controls": [
    { "id": "speed", "type": "range", "label": "Wind speed", "min": 1, "max": 20, "step": 0.5, "unit": "m/s", "default": 5, "phone": true },
    { "id": "direction", "type": "range", "label": "Wind from", "min": 0, "max": 355, "step": 5, "unit": "°", "default": 270, "phone": true },
    {
      "id": "style", "type": "select", "label": "Show", "default": "ribbons", "tier": "primary",
      "options": [
        { "value": "ribbons", "label": "Ribbons" },
        { "value": "particles", "label": "Particles" },
        { "value": "map", "label": "Speed map" }
      ]
    },
    {
      "id": "scale", "type": "select", "label": "Colour range", "default": "10", "tier": "more",
      "options": [
        { "value": "5", "label": "5 m/s" },
        { "value": "10", "label": "10 m/s" },
        { "value": "20", "label": "20 m/s" },
        { "value": "40", "label": "40 m/s" }
      ]
    },
    { "id": "backdrop", "type": "range", "label": "Speed map underneath", "min": 0, "max": 1, "step": 0.05, "default": 0.25, "tier": "more" },
    { "id": "facades", "type": "toggle", "label": "Light the walls the wind hits", "default": true, "tier": "more" },
    { "id": "trees", "type": "toggle", "label": "Trees slow the wind", "default": true, "tier": "more" },
    {
      "id": "detail", "type": "select", "label": "Detail", "default": "256", "tier": "more",
      "options": [
        { "value": "128", "label": "Coarse" },
        { "value": "256", "label": "Normal" },
        { "value": "512", "label": "Fine" }
      ]
    },
    { "id": "playback", "type": "range", "label": "Animation speed", "min": 0.25, "max": 3, "step": 0.25, "unit": "×", "default": 1, "tier": "more" },
    { "id": "opacity", "type": "range", "label": "Opacity", "min": 0.1, "max": 1, "step": 0.05, "default": 1, "tier": "more" }
  ],
  "tools": []
}
