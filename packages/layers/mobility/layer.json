{
  "api": 1,
  "id": "mobility",
  "name": "Mobility",
  "description": "People on the move: trips played over time, and a map of how travel differs from place to place",
  "about": {"purpose": "Shows how people move over a day and where travel differs, from trip data.", "questions": ["When and where are people on the move?", "Which parts of the site are hard to reach?"], "pairs_with": ["transit", "cars", "street-life"], "limits": ["Needs a trips dataset"]},
  "icon": "route",
  "attract": { "effect": "particles" },
  "requires": { "data": ["trips"] },
  "controls": [
    { "id": "play", "type": "toggle", "label": "Play", "default": true, "phone": true, "tier": "more" },
    { "id": "progress", "type": "range", "label": "Time", "min": 0, "max": 100, "step": 0.5, "unit": "%", "default": 0, "phone": true, "tier": "more" },
    {
      "id": "speed", "type": "select", "label": "Speed", "default": "60",
      "options": [
        { "value": "30", "label": "Slow" },
        { "value": "60", "label": "Normal" },
        { "value": "180", "label": "Fast" }
      ]
    },
    { "id": "trips", "type": "toggle", "label": "Show trips", "default": true },
    { "id": "routes", "type": "toggle", "label": "Show their routes", "default": true, "visibleWhen": { "trips": true }, "tier": "more" },
    { "id": "cells", "type": "toggle", "label": "Show the map of values", "default": true, "tier": "more" },
    { "id": "opacity", "type": "range", "label": "Opacity", "min": 0.1, "max": 1, "step": 0.05, "default": 1, "tier": "more" }
  ],
  "tools": []
}
