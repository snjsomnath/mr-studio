    { "id": "lit", "type": "range", "label": "Windows lit", "min": 0, "max": 1, "step": 0.05, "default": 0.45, "phone": true },
    { "id": "color", "type": "color", "label": "Light colour", "default": "#ffd08a", "tier": "more" },
    { "id": "pace", "type": "range", "label": "Change pace", "min": 0.1, "max": 3, "step": 0.1, "default": 1, "tier": "more" },
    { "id": "opacity", "type": "range", "label": "Opacity", "min": 0.1, "max": 1, "step": 0.05, "default": 0.9, "tier": "more" }
  ],
  "tools": []
