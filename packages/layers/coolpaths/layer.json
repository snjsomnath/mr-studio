{
  "api": 1,
  "id": "coolpaths",
  "name": "Cool paths",
  "description": "The shortest walk between two points, and the one with the least heat (PET), as in the Chalmers demo",
  "about": {"purpose": "Compares the shortest walk with the most comfortable one in summer heat (PET), so people see where shade and trees matter.", "questions": ["Which route would you take on a hot afternoon, and why?", "Where does a proposal remove shade from a walking route?"], "pairs_with": ["sunlight", "trees", "isovist"], "limits": ["Needs a walkways network", "Comfort is modelled for one weather setting at a time"]},
  "icon": "footprints",
  "attract": { "effect": "sun" },
  "requires": { "kernels": ["sunlight"], "data": ["walkways"] },
  "controls": [
    { "id": "date", "type": "date", "label": "Date", "default": "2026-07-15", "phone": true },
    { "id": "hour", "type": "range", "label": "Time of day", "min": 0, "max": 24, "step": 0.25, "unit": "h", "default": 14, "phone": true, "tier": "more" },
    { "id": "play", "type": "toggle", "label": "Animate the day", "default": false, "tier": "more" },
    { "id": "detour", "type": "range", "label": "Longest detour", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50, "phone": true },
    { "id": "example", "type": "action", "label": "Try another walk", "phone": true, "tier": "primary" },
    { "id": "network", "type": "toggle", "label": "Colour every path by PET", "default": true, "tier": "more" },
    { "id": "shade", "type": "toggle", "label": "Show the heat map", "default": true },
    { "id": "air", "type": "range", "label": "Afternoon air temperature", "min": 5, "max": 40, "step": 1, "unit": "°C", "default": 24, "tier": "more" },
    { "id": "humidity", "type": "range", "label": "Humidity", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 50, "tier": "more" },
    { "id": "wind", "type": "range", "label": "Wind", "min": 0, "max": 8, "step": 0.5, "unit": "m/s", "default": 1.5, "tier": "more" }
  ],
  "panels": [
    { "id": "walks", "widget": "custom", "size": "wide", "title": "Shortest and coolest walk", "props": { "reads": 5 } }
  ],
  "tools": [
    { "id": "from", "type": "point", "label": "Start of the walk" },
    { "id": "to", "type": "point", "label": "End of the walk" }
  ]
}
