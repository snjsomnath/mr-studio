{
  "api": 1,
  "id": "basemap",
  "name": "Base map",
  "description": "What the table stands on: your own streets and buildings drawn dark, a light, dark, grey, street or terrain map, an aerial photo, a map from your sources (Mapbox, CARTO, Lantmäteriet), or plain ground",
  "icon": "map",
  "category": "base",
  "controls": [
    {
      "id": "style", "type": "select", "label": "Style", "default": "dark",
      "options": [
        { "value": "dark", "label": "Dark, from your data" },
        { "value": "darkmatter", "label": "Dark canvas" },
        { "value": "darkmap", "label": "Night street map" },
        { "value": "light", "label": "Light map" },
        { "value": "grey", "label": "Grey canvas" },
        { "value": "streets", "label": "Street map" },
        { "value": "topo", "label": "Terrain map" },
        { "value": "aerial", "label": "Aerial photo" },
        { "value": "source", "label": "From your sources" },
        { "value": "plain", "label": "Plain ground" }
      ]
    },
    { "id": "source", "type": "text", "label": "Map source", "default": "", "sources": ["mapbox", "carto", "lantmateriet", "tiles", "arcgis", "wmts"], "visibleWhen": { "style": "source" } },
    { "id": "grey", "type": "toggle", "label": "Black and white", "default": false, "visibleWhen": { "style": ["darkmatter", "darkmap", "light", "grey", "streets", "topo", "aerial", "source"] } },
    { "id": "brightness", "type": "range", "label": "Brightness", "min": 0.2, "max": 1.2, "step": 0.05, "default": 1, "visibleWhen": { "style": ["darkmatter", "darkmap", "light", "grey", "streets", "topo", "aerial", "source"] } },
    { "id": "ground", "type": "color", "label": "Ground", "default": "#0b0e14" },
    { "id": "streets", "type": "toggle", "label": "Streets", "default": true, "visibleWhen": { "style": "dark" } },
    { "id": "streetColor", "type": "color", "label": "Street colour", "default": "#1b2233", "visibleWhen": { "style": "dark", "streets": true } },
    { "id": "buildingColor", "type": "color", "label": "Buildings", "default": "#232b3d", "visibleWhen": { "style": "dark" } },
    { "id": "outlines", "type": "toggle", "label": "Building outlines", "default": true, "visibleWhen": { "style": "dark" } },
    { "id": "opacity", "type": "range", "label": "Opacity", "min": 0.1, "max": 1, "step": 0.05, "default": 1 }
  ],
  "tools": []
}
