{
  "api": 1,
  "id": "basemap",
  "name": "Base map",
  "description": "What the table stands on: your own streets and buildings drawn dark, a light or street map, an aerial photo, or plain ground",
  "icon": "map",
  "category": "base",
  "controls": [
    {
      "id": "style", "type": "select", "label": "Style", "default": "dark",
      "options": [
        { "value": "dark", "label": "Dark, from your data" },
        { "value": "light", "label": "Light map" },
        { "value": "streets", "label": "Street map" },
        { "value": "aerial", "label": "Aerial photo" },
        { "value": "plain", "label": "Plain ground" }
      ]
    },
    { "id": "ground", "type": "color", "label": "Ground", "default": "#0b0e14" },
    { "id": "streets", "type": "toggle", "label": "Streets", "default": true, "visibleWhen": { "style": "dark" } },
    { "id": "streetColor", "type": "color", "label": "Street colour", "default": "#1b2233", "visibleWhen": { "style": "dark", "streets": true } },
    { "id": "buildingColor", "type": "color", "label": "Buildings", "default": "#232b3d", "visibleWhen": { "style": "dark" } },
    { "id": "outlines", "type": "toggle", "label": "Building outlines", "default": true, "visibleWhen": { "style": "dark" } },
    { "id": "opacity", "type": "range", "label": "Opacity", "min": 0.1, "max": 1, "step": 0.05, "default": 1 }
  ],
  "tools": []
}
