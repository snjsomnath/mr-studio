{
  "api": 1,
  "id": "basemap",
  "name": "Dark base map",
  "description": "Ground, streets and building footprints as a quiet backdrop",
  "icon": "map",
  "category": "base",
  "requires": { "data": ["buildings", "roads"] },
  "controls": [
    { "id": "ground", "type": "color", "label": "Ground", "default": "#0b0e14" },
    { "id": "streets", "type": "toggle", "label": "Streets", "default": true },
    { "id": "streetColor", "type": "color", "label": "Street colour", "default": "#1b2233", "visibleWhen": { "streets": true } },
    { "id": "buildingColor", "type": "color", "label": "Buildings", "default": "#232b3d" },
    { "id": "outlines", "type": "toggle", "label": "Building outlines", "default": true },
    { "id": "opacity", "type": "range", "label": "Opacity", "min": 0.1, "max": 1, "step": 0.05, "default": 1 }
  ],
  "tools": []
}
