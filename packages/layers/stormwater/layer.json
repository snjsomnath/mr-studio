{
  "api": 1,
  "id": "stormwater",
  "name": "Stormwater",
  "description": "Rain running off roofs and slopes, gathering in streams and pooling, live as the storm goes on",
  "about": {"purpose": "Shows where rain runs off and pools during a storm, live, so people see flood risk and where water could be kept.", "questions": ["Where does water gather in a cloudburst?", "Where could green or blue space hold it?"], "pairs_with": ["trees", "plan", "sketch"], "limits": ["Uses the site's terrain and buildings; better with a terrain file"]},
  "icon": "droplet",
  "category": "analysis",
  "attract": { "effect": "rain" },
  "requires": { "kernels": ["stormwater"] },
  "controls": [
    { "id": "rain", "type": "range", "label": "Rain", "min": 0, "max": 150, "step": 5, "unit": "mm/h", "default": 40, "phone": true, "tier": "primary" },
    { "id": "again", "type": "action", "label": "Start the storm again", "phone": true, "tier": "primary" },
    {
      "id": "show", "type": "select", "label": "Show", "default": "both", "tier": "secondary",
      "options": [
        { "value": "both", "label": "Running water and pools" },
        { "value": "flow", "label": "Running water" },
        { "value": "pools", "label": "Pools" }
      ]
    },
    { "id": "pace", "type": "range", "label": "Storm speed", "min": 10, "max": 300, "step": 10, "unit": "×", "default": 60, "tier": "more" },
    { "id": "infiltration", "type": "range", "label": "Ground soaks up", "min": 0, "max": 50, "step": 1, "unit": "mm/h", "default": 5, "tier": "more" },
    { "id": "roofs", "type": "toggle", "label": "Roofs drain to the ground", "default": true, "tier": "more" },
    { "id": "trees", "type": "toggle", "label": "Ground under trees soaks up more", "default": true, "tier": "more" },
    {
      "id": "detail", "type": "select", "label": "Detail", "default": "384", "tier": "more",
      "options": [
        { "value": "192", "label": "Coarse" },
        { "value": "384", "label": "Normal" },
        { "value": "768", "label": "Fine" }
      ]
    },
    { "id": "drops", "type": "range", "label": "Drops", "min": 200, "max": 4000, "step": 100, "default": 1600, "tier": "more" },
    { "id": "opacity", "type": "range", "label": "Opacity", "min": 0.1, "max": 1, "step": 0.05, "default": 1, "tier": "more" }
  ],
  "tools": [],
  "panels": [
    { "id": "time", "widget": "stat", "size": "tile", "title": "Into the storm",
      "props": { "value": { "bind": "shared.minutes" }, "unit": "min", "decimals": 0, "caption": { "bind": "shared.status" } } },
    { "id": "fallen", "widget": "stat", "size": "tile", "title": "Rain so far",
      "props": { "value": { "bind": "shared.rainMm" }, "unit": "mm", "decimals": 1, "caption": { "bind": "shared.rainCaption" } } },
    { "id": "water", "widget": "stat", "size": "tile", "title": "Water on the ground",
      "props": { "value": { "bind": "shared.waterM3" }, "unit": "m³", "decimals": 0, "caption": { "bind": "shared.waterCaption" } } },
    { "id": "key", "widget": "ramp", "size": "band", "title": "Pools, by depth",
      "props": { "colormap": { "bind": "shared.ramp" }, "low": "0", "high": "1 m" } }
  ]
}
