{
  "api": 1,
  "id": "media",
  "name": "Picture or video",
  "description": "A picture or a video of the site laid over the whole table, such as a simulation, an old photo or a film of a sun study",
  "icon": "images",
  "attract": { "effect": "grid" },
  "category": "media",
  "hidesAtRest": true,
  "controls": [
    { "id": "file", "type": "text", "label": "File", "default": "", "media": ["picture", "video"], "mediaBy": "path", "tier": "more" },
    {
      "id": "fit", "type": "select", "label": "Fit to the table", "default": "stretch", "tier": "more",
      "options": [
        { "value": "stretch", "label": "Stretch to the table's edges" },
        { "value": "contain", "label": "Whole picture, with margins" },
        { "value": "cover", "label": "Fill the table, cropping" }
      ]
    },
    {
      "id": "rotation", "type": "select", "label": "Turn", "default": "0", "tier": "more",
      "options": [
        { "value": "0", "label": "As it is" },
        { "value": "90", "label": "A quarter turn clockwise" },
        { "value": "180", "label": "Upside down" },
        { "value": "270", "label": "A quarter turn anticlockwise" }
      ]
    },
    { "id": "loop", "type": "toggle", "label": "Video plays again from the start", "default": true, "tier": "more" },
    { "id": "opacity", "type": "range", "label": "Opacity", "min": 0.1, "max": 1, "step": 0.05, "default": 1, "tier": "more" }
  ],
  "tools": []
}
