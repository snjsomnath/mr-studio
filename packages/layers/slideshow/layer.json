{
  "api": 1,
  "id": "slideshow",
  "name": "Slideshow",
  "description": "Images, video and map data shown on the table one after another",
  "icon": "images",
  "attract": { "effect": "grid" },
  "category": "media",
  "sequence": true,
  "hidesAtRest": true,
  "controls": [
    { "id": "slide", "type": "range", "label": "Slide", "min": 1, "max": 200, "step": 1, "default": 1, "phone": true },
    { "id": "previous", "type": "action", "label": "Previous slide", "phone": true },
    { "id": "next", "type": "action", "label": "Next slide", "phone": true },
    { "id": "play", "type": "toggle", "label": "Advance automatically", "default": true },
    { "id": "seconds", "type": "range", "label": "Seconds per slide (0 uses each slide's own)", "min": 0, "max": 60, "step": 1, "default": 0, "visibleWhen": { "play": true } },
    { "id": "captions", "type": "toggle", "label": "Titles on the table", "default": false },
    { "id": "opacity", "type": "range", "label": "Opacity", "min": 0.1, "max": 1, "step": 0.05, "default": 1 }
  ],
  "tools": []
}
