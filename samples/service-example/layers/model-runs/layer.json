{
  "api": 1,
  "id": "model-runs",
  "name": "Model runs",
  "description": "A layer whose numbers come from a model running beside the table: tap a building to change it",
  "icon": "bolt",
  "category": "analysis",
  "requires": {
    "services": [
      "model"
    ],
    "data": [
      "buildings"
    ]
  },
  "controls": [
    {
      "id": "share",
      "type": "range",
      "label": "Shared solar",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.3
    },
    {
      "id": "days",
      "type": "select",
      "label": "Optimise over",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "One day"
        },
        {
          "value": "2",
          "label": "Two days"
        },
        {
          "value": "5",
          "label": "A week of workdays"
        }
      ]
    },
    {
      "id": "optimise",
      "type": "action",
      "label": "Find the best share",
      "tier": "primary"
    }
  ],
  "panels": [
    {
      "id": "import",
      "widget": "grid-link",
      "size": "tile",
      "title": "From the grid",
      "props": {
        "value": {
          "bind": "shared.import_kw"
        },
        "max": 15000,
        "unit": "kW"
      }
    },
    {
      "id": "saving",
      "widget": "stat",
      "size": "tile",
      "title": "Best saving",
      "props": {
        "value": {
          "bind": "shared.saving"
        },
        "unit": "SEK",
        "caption": {
          "bind": "shared.best"
        }
      }
    },
    {
      "id": "scenarios",
      "widget": "compare",
      "size": "wide",
      "title": "From the grid",
      "props": {
        "scenarios": {
          "bind": "shared.scenarios"
        },
        "unit": "kW",
        "better": "lower"
      }
    },
    {
      "id": "balance",
      "widget": "balance",
      "size": "wide",
      "title": "Where the power comes from",
      "props": {
        "sources": {
          "bind": "shared.sources"
        },
        "uses": {
          "bind": "shared.uses"
        },
        "headline": {
          "bind": "shared.self_sufficiency"
        },
        "headline_label": "self-sufficient",
        "unit": "kW"
      }
    },
    {
      "id": "scenarios-ribbon",
      "widget": "compare",
      "size": "chip",
      "title": "Against today",
      "ribbon": true,
      "props": {
        "scenarios": {
          "bind": "shared.scenarios"
        },
        "better": "lower"
      }
    },
    {
      "id": "balance-ribbon",
      "widget": "balance",
      "size": "chip",
      "title": "Own power",
      "ribbon": true,
      "props": {
        "sources": {
          "bind": "shared.sources"
        },
        "headline": {
          "bind": "shared.self_sufficiency"
        },
        "headline_label": "self-sufficient"
      }
    },
    {
      "id": "grid-ribbon",
      "widget": "grid-link",
      "size": "chip",
      "title": "From the grid",
      "ribbon": true,
      "props": {
        "value": {
          "bind": "shared.import_kw"
        },
        "max": 15000
      }
    }
  ],
  "entities": [
    {
      "id": "buildings",
      "dataset": "buildings",
      "key": "id",
      "group": "kind",
      "name": "Building",
      "debounce_ms": 800,
      "controls": [
        {
          "id": "in",
          "type": "toggle",
          "label": "In the energy community",
          "default": true,
          "phone": true
        },
        {
          "id": "pv",
          "type": "range",
          "label": "Solar on the roof",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 0
        }
      ]
    }
  ],
  "sound": [
    {
      "id": "grid",
      "kind": "noise",
      "level": {
        "bind": "shared.import_kw",
        "from": [
          0,
          400
        ],
        "to": [
          0,
          0.6
        ],
        "curve": "sqrt"
      },
      "centre": {
        "bind": "shared.import_kw",
        "from": [
          0,
          400
        ],
        "to": [
          260,
          900
        ]
      },
      "width": 1.2,
      "glide_s": 3
    },
    {
      "id": "hum",
      "kind": "hum",
      "frequency": 100,
      "harmonics": 4,
      "level": {
        "bind": "shared.import_kw",
        "from": [
          50,
          400
        ],
        "to": [
          0,
          0.35
        ]
      },
      "glide_s": 3
    }
  ],
  "stage": {
    "panels": [
      {
        "id": "map",
        "widget": "map",
        "size": "block",
        "title": "Pick a building",
        "at": {
          "col": 1,
          "row": 1
        },
        "props": {
          "data": [
            {
              "name": "roads",
              "slot": 2
            }
          ],
          "entities": "buildings",
          "hint": "Tap a building to change it"
        }
      },
      {
        "id": "grid",
        "widget": "grid-link",
        "size": "tile",
        "title": "From the grid",
        "at": {
          "col": 7,
          "row": 1
        },
        "props": {
          "value": {
            "bind": "shared.import_kw"
          },
          "max": 15000
        }
      },
      {
        "id": "self",
        "widget": "gauge",
        "size": "tile",
        "title": "Self-sufficiency",
        "at": {
          "col": 10,
          "row": 1
        },
        "props": {
          "value": {
            "bind": "shared.self_sufficiency"
          },
          "max": 1,
          "target": 0.5,
          "format": "percent",
          "slot": 3
        }
      },
      {
        "id": "share",
        "widget": "control",
        "size": "wide",
        "title": "Shared solar",
        "at": {
          "col": 7,
          "row": 3
        },
        "props": {
          "control": "share"
        }
      },
      {
        "id": "scen",
        "widget": "compare",
        "size": "wide",
        "title": "From the grid",
        "at": {
          "col": 1,
          "row": 5
        },
        "props": {
          "scenarios": {
            "bind": "shared.scenarios"
          },
          "unit": "kW",
          "better": "lower"
        }
      },
      {
        "id": "go",
        "widget": "control",
        "size": "tile",
        "title": "Optimiser",
        "at": {
          "col": 7,
          "row": 5
        },
        "props": {
          "control": "optimise"
        }
      },
      {
        "id": "days",
        "widget": "control",
        "size": "tile",
        "title": "Over",
        "at": {
          "col": 10,
          "row": 5
        },
        "props": {
          "control": "days"
        }
      }
    ]
  }
}