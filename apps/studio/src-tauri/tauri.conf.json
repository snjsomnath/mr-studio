{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MR Studio",
  "identifier": "app.mrstudio.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://github.com https://*.githubusercontent.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "MR Studio",
    "longDescription": "Puts a real place on a projected table, with a TV for controls and phones for participation.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "staged/web": "web",
      "staged/layers": "layers",
      "staged/sites": "sites"
    },
    "fileAssociations": [
      {
        "ext": [
          "mrstable"
        ],
        "name": "MR Studio table",
        "description": "An MR Studio table, to open on another computer",
        "role": "Editor",
        "mimeType": "application/x-mrstable"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 186
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 186
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
