{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The shell's own pages (Home, and displays and settings) may call every command.",
  "windows": [
    "home",
    "launcher"
  ],
  "permissions": [
    "core:event:default",
    "allow-launcher-state",
    "allow-add-site",
    "allow-remove-site",
    "allow-delete-table",
    "allow-identify",
    "allow-start",
    "allow-open-site",
    "allow-create-site",
    "allow-present",
    "allow-stop-presenting",
    "allow-presenting-state",
    "allow-save-displays",
    "allow-save-settings",
    "allow-open-home",
    "allow-quit",
    "allow-colour-state",
    "allow-set-colour",
    "allow-save-preset",
    "allow-delete-preset",
    "allow-test-card",
    "allow-set-layer-intensity",
    "allow-calibration-state",
    "allow-calibration-mode",
    "allow-calibration-clear",
    "allow-update-state",
    "allow-check-updates",
    "allow-set-update-check",
    "allow-install-update",
    "allow-dismiss-whats-new",
    "allow-open-link",
    "allow-open-settings",
    "allow-new-table",
    "allow-table-details",
    "allow-open-sources"
  ]
}
